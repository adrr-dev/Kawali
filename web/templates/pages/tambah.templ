package pages

import (
	"mewali/internal/models"
	"mewali/web/templates/components"
	"mewali/web/templates/layout"
)

// Tambah menampilkan form katalog baru (draft).
templ Tambah(errMsg string) {
	@layout.Base("Tambah Katalog") {
		<main class="page">
			<h1 class="title">TAMBAH KATALOG</h1>
			if errMsg != "" {
				<p class="formerror" role="alert">{ errMsg }</p>
			}
			<form method="POST" action="/katalog" class="form">
				<label class="field"><input type="text" name="name" placeholder="Nama barang" required/></label>
				<label class="field">
					<select name="category">
						for _, c := range models.Categories {
							<option value={ c }>{ c }</option>
						}
					</select>
				</label>
				<label class="field"><input type="number" name="price" min="1" step="1" placeholder="Harga (Rp)" required/></label>
				<label class="field"><input type="text" name="description" placeholder="Deskripsi"/></label>
				<h2>Ukuran barang (cm)</h2>
				<label class="field"><input type="number" name="dada" min="0" step="0.1" placeholder="Lebar Dada"/></label>
				<label class="field"><input type="number" name="pinggang" min="0" step="0.1" placeholder="Lingkar Pinggang"/></label>
				<label class="field"><input type="number" name="pinggul" min="0" step="0.1" placeholder="Lingkar Pinggul"/></label>
				<label class="field"><input type="number" name="tinggi" min="0" step="0.1" placeholder="Tinggi Badan"/></label>
				<label class="field"><input type="number" name="torso" min="0" step="0.1" placeholder="Panjang Torso"/></label>
				<button class="btn" type="submit">Simpan Draf</button>
			</form>
		</main>
		@components.Dock("profil")
	}
}
